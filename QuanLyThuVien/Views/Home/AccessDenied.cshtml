@{
    ViewData["Title"] = "Từ chối truy cập (403 Forbidden)";
}

<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-danger">
                <div class="card-body p-5">
                    <div class="text-danger mb-3" style="font-size: 4rem;">
                        <i class="bi bi-shield-x"></i> 403
                    </div>
                    <h3 class="card-title text-danger fw-bold">KHÔNG CÓ QUYỀN TRUY CẬP!</h3>
                    <p class="text-muted mt-3">
                        Rất tiếc, tài khoản hiện tại của bạn không đủ quyền hạn (Yêu cầu quyền <strong>Quản lý / Admin</strong>) để thực hiện thao tác này.
                    </p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-book"></i> Về danh sách Sách
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
