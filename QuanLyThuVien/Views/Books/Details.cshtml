@model QuanLyThuVien.Models.Book

@{
    ViewData["Title"] = "Chi tiết sách - Lab 5";
    bool isManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-info text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle"></i> Chi Tiết Cuốn Sách</h5>
            </div>
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-3 text-muted">Mã sách:</dt>
                    <dd class="col-sm-9 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-3 text-muted">Mã ISBN:</dt>
                    <dd class="col-sm-9"><code>@Model.ISBN</code></dd>

                    <dt class="col-sm-3 text-muted">Tên sách:</dt>
                    <dd class="col-sm-9 text-primary fw-bold">@Model.Title</dd>

                    <dt class="col-sm-3 text-muted">Thể loại:</dt>
                    <dd class="col-sm-9"><span class="badge bg-info text-dark">@(Model.CategoryName ?? "Chưa phân loại")</span></dd>

                    <dt class="col-sm-3 text-muted">Tác giả:</dt>
                    <dd class="col-sm-9">@(Model.Author ?? "N/A")</dd>

                    <dt class="col-sm-3 text-muted">Năm xuất bản:</dt>
                    <dd class="col-sm-9">@Model.PublishYear</dd>

                    <dt class="col-sm-3 text-muted">Giá bìa:</dt>
                    <dd class="col-sm-9 text-danger fw-bold">@Model.Price.ToString("N0") VNĐ</dd>

                    <dt class="col-sm-3 text-muted">Tồn kho:</dt>
                    <dd class="col-sm-9">@Model.AvailableQuantity / @Model.Quantity cuốn</dd>

                    <dt class="col-sm-3 text-muted">Ảnh bìa:</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                        {
                            <img src="@Model.CoverImage" alt="@Model.Title" class="img-thumbnail" style="max-height:150px;" />
                        }
                        else
                        {
                            <span class="text-muted">Chưa có ảnh bìa</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Mô tả:</dt>
                    <dd class="col-sm-9">@(Model.Description ?? "Không có mô tả")</dd>

                    <dt class="col-sm-3 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-9">@(Model.Active ? "Đang lưu hành" : "Ngưng lưu hành")</dd>
                </dl>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách
                    </a>
                    @if (isManager)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Chỉnh sửa sách
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
