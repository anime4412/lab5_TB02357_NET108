@model QuanLyThuVien.Models.Book

@{
    ViewData["Title"] = "Chỉnh sửa sách - Lab 5";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> Cập Nhật Thông Tin Sách</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CoverImage" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ISBN" class="form-label fw-bold"></label>
                            <input asp-for="ISBN" class="form-control" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Chọn thể loại --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label fw-bold"></label>
                            <input asp-for="Author" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PublishYear" class="form-label fw-bold"></label>
                            <input asp-for="PublishYear" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-bold"></label>
                            <input asp-for="Price" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label fw-bold"></label>
                            <input asp-for="Quantity" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AvailableQuantity" class="form-label fw-bold"></label>
                            <input asp-for="AvailableQuantity" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Ảnh bìa hiện tại:</label>
                            <div class="mb-2">
                                @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                                {
                                    <img src="@Model.CoverImage" alt="@Model.Title" class="img-thumbnail" style="max-height:120px;" />
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border p-2">Chưa có ảnh bìa</span>
                                }
                            </div>
                            <input type="file" name="coverFile" class="form-control" accept="image/*" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Active" class="form-check-input" />
                                <label asp-for="Active" class="form-check-label fw-bold"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-check-circle"></i> Cập Nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
