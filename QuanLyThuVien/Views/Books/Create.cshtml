@model QuanLyThuVien.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới - Lab 5";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle"></i> Thêm Sách Mới Vào Thư Viện</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ISBN" class="form-label fw-bold"></label>
                            <input asp-for="ISBN" class="form-control" placeholder="VD: 9786041234567" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Chọn thể loại --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Nhập tên sách..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label fw-bold"></label>
                            <input asp-for="Author" class="form-control" placeholder="Tên tác giả..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PublishYear" class="form-label fw-bold"></label>
                            <input asp-for="PublishYear" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-bold"></label>
                            <input asp-for="Price" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label fw-bold"></label>
                            <input asp-for="Quantity" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AvailableQuantity" class="form-label fw-bold"></label>
                            <input asp-for="AvailableQuantity" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Ảnh bìa sách (Upload qua FileUtil)</label>
                            <input type="file" name="coverFile" class="form-control" accept="image/*" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Active" class="form-check-input" />
                                <label asp-for="Active" class="form-check-label fw-bold"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="bi bi-save"></i> Lưu Sách
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
