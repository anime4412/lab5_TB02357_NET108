@model QuanLyThuVien.Models.Book

@{
    ViewData["Title"] = "Xác nhận xóa sách - Lab 5";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-trash"></i> Xác Nhận Xóa Sách</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> Bạn có chắc chắn muốn xóa cuốn sách này khỏi thư viện không?
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Mã ISBN:</dt>
                    <dd class="col-sm-8"><code>@Model.ISBN</code></dd>

                    <dt class="col-sm-4 text-muted">Tên sách:</dt>
                    <dd class="col-sm-8 text-primary fw-bold">@Model.Title</dd>

                    <dt class="col-sm-4 text-muted">Tác giả:</dt>
                    <dd class="col-sm-8">@(Model.Author ?? "N/A")</dd>

                    <dt class="col-sm-4 text-muted">Giá bìa:</dt>
                    <dd class="col-sm-8 text-danger fw-bold">@Model.Price.ToString("N0") đ</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger fw-bold px-4">
                            <i class="bi bi-trash"></i> Đồng Ý Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
