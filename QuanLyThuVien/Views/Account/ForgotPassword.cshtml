@model QuanLyThuVien.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Cấp lại mật khẩu - Lab 5";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-warning text-dark text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-key"></i> CẤP LẠI MẬT KHẨU (BÀI 2)</h4>
                <small>Đặt lại mật khẩu ngẫu nhiên &amp; gửi tới Email nhân viên</small>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Success == true)
                {
                    <div class="alert alert-success">
                        <h6 class="fw-bold"><i class="bi bi-check-circle-fill"></i> Yêu cầu xử lý thành công!</h6>
                        <p class="mb-1">@ViewBag.StatusMessage</p>
                        @if (ViewBag.DemoNewPassword != null)
                        {
                            <div class="mt-2 p-2 bg-white border rounded text-center">
                                <span class="small text-muted d-block">Mật khẩu mới đã cập nhật vào CSDL (hiển thị phục vụ kiểm thử Offline):</span>
                                <code class="fs-5 fw-bold text-danger">@ViewBag.DemoNewPassword</code>
                            </div>
                        }
                    </div>
                    <div class="d-grid mt-3">
                        <a asp-action="Login" class="btn btn-primary fw-bold">
                            <i class="bi bi-box-arrow-in-right"></i> Quay lại Đăng nhập bằng mật khẩu mới
                        </a>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Nhập địa chỉ Email nhân viên đã đăng ký trong hệ thống. Hệ thống sẽ tạo ngẫu nhiên mật khẩu mới vào CSDL và gửi về Email của bạn.
                    </p>
                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="Ví dụ: thuthu@thuvien.edu.vn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Login" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại Đăng nhập
                            </a>
                            <button type="submit" class="btn btn-warning fw-bold px-4">
                                <i class="bi bi-send"></i> Cấp Lại Mật Khẩu
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
