@model QuanLyThuVien.Models.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống - Lab 5";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-arrow-in-right"></i> ĐĂNG NHẬP THƯ VIỆN</h4>
                <small class="text-white-50">Môn: Dự án .NET 1 (NET108) | Sinh viên: TB02357 - Nhóm 5</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ email..." />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a asp-action="ForgotPassword" class="text-decoration-none small fw-bold text-primary">
                            <i class="bi bi-question-circle"></i> Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-shield-lock"></i> Đăng Nhập
                    </button>
                </form>

                <hr class="my-4" />

                <div class="card bg-light border-dashed">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-info-circle"></i> Tài khoản mẫu kiểm thử:</h6>
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-1">
                                <span class="badge bg-danger">Admin:</span>
                                <code>admin@thuvien.edu.vn</code> / <code>Admin@123</code>
                            </li>
                            <li>
                                <span class="badge bg-info text-dark">Thủ thư:</span>
                                <code>thuthu@thuvien.edu.vn</code> / <code>Thuthu@123</code>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
