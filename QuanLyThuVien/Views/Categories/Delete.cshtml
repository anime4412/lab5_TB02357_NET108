@model QuanLyThuVien.Models.Category

@{
    ViewData["Title"] = "Xóa thể loại - Lab 5";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white"><h5 class="mb-0">Xác Nhận Xóa Thể Loại</h5></div>
            <div class="card-body">
                <p>Bạn có chắc chắn muốn xóa thể loại <strong>@Model.Name</strong>?</p>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>
