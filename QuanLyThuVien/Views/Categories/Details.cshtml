@model QuanLyThuVien.Models.Category

@{
    ViewData["Title"] = "Chi tiết thể loại - Lab 5";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-info text-white"><h5 class="mb-0">Chi Tiết Thể Loại</h5></div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">ID</dt><dd class="col-sm-8">#@Model.Id</dd>
                    <dt class="col-sm-4">Tên thể loại</dt><dd class="col-sm-8 fw-bold">@Model.Name</dd>
                    <dt class="col-sm-4">Mô tả</dt><dd class="col-sm-8">@Model.Description</dd>
                    <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@(Model.Active ? "Đang dùng" : "Tạm ngưng")</dd>
                </dl>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>
